{
  "$schema": "https://shadcn-swift.local/schema/registry-v1.json",
  "version": 1,
  "components": [
    {
      "name": "tokens",
      "description": "Design tokens (color, spacing, radius, typography) exposed via SwiftUI Environment",
      "dependencies": [],
      "platforms": {
        "swiftui": {
          "files": ["Theme.swift", "Tokens.swift"]
        }
      }
    },
    {
      "name": "button",
      "description": "Primary/secondary/ghost button style",
      "dependencies": ["tokens"],
      "platforms": {
        "swiftui": {
          "files": ["Button.swift"]
        }
      }
    },
    {
      "name": "card",
      "description": "Card container with optional trailing action button",
      "dependencies": ["tokens", "button"],
      "platforms": {
        "swiftui": {
          "files": ["Card.swift"]
        }
      }
    },
    {
      "name": "badge",
      "description": "Small status/label pill (primary/secondary/outline)",
      "dependencies": ["tokens"],
      "platforms": {
        "swiftui": {
          "files": ["Badge.swift"]
        }
      }
    },
    {
      "name": "input",
      "description": "Styled text field with focus ring and an invalid/error state",
      "dependencies": ["tokens"],
      "platforms": {
        "swiftui": {
          "files": ["Input.swift"]
        }
      }
    },
    {
      "name": "toggle",
      "description": "Themed on/off switch (custom ToggleStyle)",
      "dependencies": ["tokens"],
      "platforms": {
        "swiftui": {
          "files": ["Toggle.swift"]
        }
      }
    }
  ]
}
